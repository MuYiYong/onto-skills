  "constraints": [
    {
      "id": "log-identity",
      "subject": "model",
      "rule": "保留 source/issuer/provider 命名空间；Shipment、Consignment、LogisticUnit、Booking、TransportDocument 不按相同字符串合并。",
      "enforcement": "application",
      "source_ids": [
        "onto-project",
        "gs1-architecture"
      ]
    },
    {
      "id": "log-event-id",
      "subject": "node:VisibilityEvent",
      "rule": "相同(source_system,event_id)语义负载一致时幂等；只改变 observed_at 为重投递。冲突负载整键隔离，不按到达顺序覆盖。不同 event_id 的真实重复扫描分别保留。",
      "enforcement": "application",
      "source_ids": [
        "onto-project"
      ]
    },
    {
      "id": "log-time",
      "subject": "node:VisibilityEvent",
      "rule": "所有 datetime 规范化为带Z的UTC，拒绝无偏移输入；保留原始偏移。event_time 是业务时点，record_time 是来源记录，observed_at 是本分析已知时点，issued_at 是发布/预测修订时点。",
      "enforcement": "application",
      "source_ids": [
        "onto-project",
        "gs1-epcis"
      ]
