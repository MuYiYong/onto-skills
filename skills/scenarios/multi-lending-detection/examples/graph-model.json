  "constraints": [
    {
      "id": "identity",
      "subject": "model",
      "rule": "实体和事件使用稳定来源标识；每条业务来源记录幂等，手机/账户共享不是主体相同的充分证据。",
      "enforcement": "application",
      "source_ids": [
        "onto-project"
      ]
    },
    {
      "id": "loan-principal",
      "subject": "node:Loan",
      "rule": "principal_amount 为十进制数且非负，currency 必填；这是对 MonetaryAmount 的有意扁平化，不保留货币量对象身份。",
      "enforcement": "application",
      "source_ids": [
        "onto-project",
        "fibo"
      ]
    },
    {
      "id": "intervals",
      "subject": "model",
      "rule": "UTC [valid_from,valid_to)；本示例 null valid_to 只表示仍有效；未知结束必须拒绝进入确定性当前暴露统计。observed_at 为首次观测，修订保存来源历史。",
      "enforcement": "application",
      "source_ids": [
        "onto-project"
      ]
    },
    {
      "id": "multilending",
      "subject": "model",
      "rule": "as_of 时点余额口径确认后，按独立 lender_id 对有效 Loan 去重；示例机构数>=2 仅产生待复核候选，申请/查询不计入贷款。",
      "enforcement": "application",
      "source_ids": [
        "onto-project"
      ]
    },
    {
      "id": "event-order",
      "subject": "model",
      "rule": "申请、查询、授信、放款、还款分别保留 event_time；先后顺序用于分析，不把晚到 observed_at 当实际发生顺序。",
      "enforcement": "application",
      "source_ids": [
        "onto-project"
      ]
    },
    {
      "id": "cardinality",
      "subject": "model",
      "rule": "BORROWS/PROVIDES 每笔示例贷款各一主体/机构；联合借款、银团贷款、担保、集团风险在本例范围之外，不能推广该基数。",
      "enforcement": "application",
      "source_ids": [
        "onto-project"
      ]
    },
    {
      "id": "fibo-scope",
      "subject": "node:Loan",
      "rule": "保留 Loan 的业务对齐；不声称实现其父类及全部进口公理的 OWL 推理。此模型仅用于示例多头借贷问题。",
      "enforcement": "review",
      "source_ids": [
        "onto-project",
        "fibo",
        "owl2"
      ]
    }
  ],
  "mappings": [
    {
      "id": "loan-class",
      "source_id": "fibo",
      "source_term": "https://spec.edmcouncil.org/fibo/ontology/LOAN/LoansGeneral/Loans/Loan",
      "target": "node:Loan",
      "status": "approximated",
      "explanation": "将范围限定为按期偿付贷款的业务合同；仅对齐该类，不能因此宣称完整 OWL/FIBO 等价。",
      "constraint_ids": [
        "fibo-scope"
      ]
    },
    {
      "id": "principal-restriction",
      "source_id": "fibo",
      "source_term": "https://spec.edmcouncil.org/fibo/ontology/LOAN/LoansGeneral/Loans/Loan subClassOf (hasPrincipalAmount some MonetaryAmount)",
      "target": "property:Loan.principal_amount",
      "status": "approximated",
      "explanation": "观察到该存在限制；以 amount/currency 两字段近似，丢失 MonetaryAmount 对象身份及量值相关推理，采用应用必填规则而非 OWL 闭世界断言。",
      "constraint_ids": [
        "loan-principal",
        "fibo-scope"
      ]
    },
    {
      "id": "periodic-parent",
      "source_id": "fibo",
      "source_term": "https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/CreditAgreementRepaidPeriodically",
      "target": null,
      "status": "unmapped",
      "explanation": "保留父类来源但不单建类型；本例用范围限制与说明保留业务解读，不实现父类推理和全部偿付计划语义。",
      "constraint_ids": [
        "fibo-scope"
      ]
    },
    {
      "id": "debt-parent",
      "source_id": "fibo",
      "source_term": "https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/DebtInstrument",
      "target": null,
      "status": "unmapped",
      "explanation": "未展开债务工具父类属性与公理；不影响本例按机构和有效期间计数，不承诺金融工具分类查询。",
      "constraint_ids": [
        "fibo-scope"
      ]
    },
    {
      "id": "business-loan-id",
      "source_id": "onto-project",
      "source_term": "input.loans.loan_id",
      "target": "property:Loan.loan_id",
      "status": "preserved",
      "explanation": "企业数据扩展主键，有独立来源命名空间，不是 FIBO 给定的标准主键。",
      "constraint_ids": [
        "identity"
      ]
    }
  ],
  "assumptions": [
    "示例贷款按期偿付；每笔恰好一个已核实借款主体和一家独立机构。",
    "不直接提供余额风险结论；真实业务需固定余额、币种、状态和机构合并口径。",
    "示例接受有界 FIBO 映射损失，不声称完整导入或原生推理；完整 imports 闭包未验证。"
  ],
  "unresolved": [],
  "competency_questions": [
    "截至 2026-02-01 哪些主体在至少两家独立机构有重叠有效贷款？",
    "哪些共享手机/收款账户关联在同一时段有效，其证据是什么？",
