{
  "type": "object",
  "properties": {
    "spec_version": {
      "const": "1.0"
    },
    "model_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "graph_type": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "type": "object",
      "properties": {
        "database": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "database",
        "version"
      ],
      "additionalProperties": false
    },
    "source_catalog": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      },
      "minItems": 1
    },
    "node_types": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      },
      "minItems": 1
    },
    "edge_types": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      },
      "minItems": 0
    },
    "constraints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/constraint"
      },
      "minItems": 0
    },
    "mappings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/mapping"
      },
      "minItems": 0
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "competency_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    }
  },
  "required": [
    "spec_version",
    "model_id",
    "version",
    "graph_type",
    "description",
    "target",
    "source_catalog",
    "node_types",
    "edge_types",
    "constraints",
    "mappings",
    "assumptions",
    "unresolved",
    "competency_questions"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Graph Model Specification 1.0",
  "$defs": {
    "source": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "authority": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "official-standard",
            "industry-common",
            "project-curated",
            "model-inference"
          ]
        },
        "retrieved_at": {
          "type": "string",
          "format": "date"
        }
      },
      "required": [
        "id",
        "name",
        "uri",
        "version",
        "publisher",
        "license",
        "scope",
        "authority",
        "kind",
        "retrieved_at"
      ],
      "additionalProperties": false
    },
    "property": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "logical_type": {
          "enum": [
            "string",
            "identifier",
            "integer",
            "decimal",
            "boolean",
            "date",
            "datetime",
            "json"
          ]
        },
        "nullable": {
          "type": "boolean"
        },
        "multivalued": {
          "type": "boolean"
        },
        "business_meaning": {
          "type": "string",
          "minLength": 1
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "name",
        "logical_type",
        "nullable",
        "multivalued",
        "business_meaning",
        "source_ids"
      ],
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "business_meaning": {
          "type": "string",
          "minLength": 1
        },
        "identity_scope": {
          "type": "string",
          "minLength": 1
        },
        "primary_key": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          },
          "minItems": 1
        },
        "properties": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/property"
          },
          "minItems": 1
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "name",
        "business_meaning",
        "identity_scope",
        "primary_key",
        "properties",
        "source_ids"
      ],
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "business_meaning": {
          "type": "string",
          "minLength": 1
        },
        "identity_scope": {
          "type": "string",
          "minLength": 1
        },
        "primary_key": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          },
          "minItems": 1
        },
        "properties": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/property"
          },
          "minItems": 1
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "from": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "to": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "direction": {
          "const": "outgoing"
        },
        "cardinality": {
          "type": "object",
          "properties": {
            "per_source": {
              "type": "string",
              "minLength": 1
            },
            "per_target": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "per_source",
            "per_target"
          ],
          "additionalProperties": false
        },
        "temporal": {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "none",
                "event_time",
                "valid_time",
                "bitemporal"
              ]
            },
            "start": {
              "type": [
                "string",
                "null"
              ]
            },
            "end": {
              "type": [
                "string",
                "null"
              ]
            },
            "observed_at": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "start",
            "end",
            "observed_at"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "name",
        "business_meaning",
        "identity_scope",
        "primary_key",
        "properties",
        "source_ids",
        "from",
        "to",
        "direction",
        "cardinality",
        "temporal"
      ],
      "additionalProperties": false
    },
    "constraint": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "rule": {
          "type": "string",
          "minLength": 1
        },
        "enforcement": {
          "enum": [
            "database",
            "application",
            "review",
            "unresolved"
          ]
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "subject",
        "rule",
        "enforcement",
        "source_ids"
      ],
      "additionalProperties": false
    },
    "mapping": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "source_term": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "preserved",
            "approximated",
            "unmapped"
          ]
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        },
        "constraint_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "id",
        "source_id",
        "source_term",
        "target",
        "status",
        "explanation",
        "constraint_ids"
      ],
      "additionalProperties": false
    }
  }
}
