  "competency_questions": [
    "截止当时每个指标用了哪些源记录版本和转换？",
    "收到但未接受的修订能否替换上一已接受版本？",
    "混币种、缺失值或错模板事实如何显式阻断？"
  ],
  "assumptions": [
    "Baseline amounts are expressed in whole yuan of currency CNY; task gave CNY amounts but no separate unit, so yuan is an explicit synthetic assumption, not a regulatory requirement.",
    "Date-only task statements are assigned example Asia/Shanghai instants. No extra source arrives on the selected cutoff days, so start/end-of-day choices do not change these results.",
    "DEMO-R1 and metric DEMO-R1:loanBalance definition synthetic-1 are user-task identifiers, not a real Chinese regulator report/template/threshold.",
    "S1 has supplied prior business acceptance; its reported amount and source lineage were not supplied and remain unknown.",
    "Locally created RUN-A-NOV3/S3 are a design draft only, with no new submitted/received/accepted event."
  ],
  "unresolved": [
    "Actual regulator/agency, official template/metric version, governance owner, lawful reporting unit, applicable calendar/deadline and quality formulas.",
    "S1 exact accepted payload amount/lineage and its payload hash are not supplied.",
    "TransformationRun in the supplied model has no direct business as_of property; in this adapted design as_of is recoverable through ReportedFact→ReportContext.period_end, and run metadata explicitly retains the selected instant. This difference is recorded rather than concealed."
  ],
  "constraints": [
    {
      "id": "C1",
      "subject": "node:ReportedFact",
      "rule": "每个事实必须恰好关联一个MetricDefinition、ReportContext、TransformationRun及所属Submission；身份包含submission_id，模板/指标/单位版本匹配。",
      "enforcement": "application",
      "source_ids": [
        "onto-reporting"
      ]
    },
    {
      "id": "C2",
      "subject": "node:SourceRecord",
      "rule": "相同(source_system,record_id,source_version)重放必须内容相同；缺失金额或缺少币种/单位转换时不得静默汇总。",
      "enforcement": "application",
      "source_ids": [
        "onto-reporting"
      ]
    },
    {
      "id": "C3",
      "subject": "edge:SUPERSEDES",
      "rule": "禁止修订环；保留旧载荷与血缘。只有business accepted回执才能更新本报表范围的已接受版本。",
      "enforcement": "application",
      "source_ids": [
        "onto-reporting"
      ]
    },
    {
      "id": "C4",
      "subject": "node:ReportDefinition",
      "rule": "真实适用制度、时间日历、指标与校验规则由责任人核实，不把合成例子当法定义务。",
      "enforcement": "review",
      "source_ids": [
        "onto-reporting"
      ]
    }
  ],
