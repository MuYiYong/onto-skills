        "status-evidence"
      ]
    },
    {
      "id": "cvss-not-local-risk",
      "source_id": "cvss40",
      "source_term": "CVSS4.0 metric groups and severity",
      "target": null,
      "status": "unmapped",
      "explanation": "Independent severity source only; not flattened into affected status, exploit evidence or CSAF2.0 CVSS structures.",
      "constraint_ids": [
        "no-operational-inference"
      ]
    }
  ],
  "assumptions": [
    "Synthetic fixture uses reviewed exact-version mappings, positive integer advisory revisions and final documents only.",
    "Graph composite identities preserve document/product/vulnerability source scopes.",
    "Any real data adapter must preserve original payload, statements and trust evidence."
  ],
  "unresolved": [
    "Select real publisher trust policy, exact version/range matching and original SPDX/CSAF validation before production use.",
    "Select target database/version and its identity/temporal constraints separately."
  ],
  "competency_questions": [
    "Which installed component/version has an affected assertion known by both cutoffs, and which source revision supports it?",
    "Which same-name components, dependencies and product mappings remain unresolved?",
    "Does published remediation have separate installed-change evidence?"
  ]
}
