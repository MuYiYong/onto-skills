  "constraints": [
    {
      "id": "scope-identity",
      "subject": "node:SoftwareComponent",
      "rule": "Same SPDXRef in different document namespaces denotes separate occurrences; retain original version and alias evidence.",
      "enforcement": "application",
      "source_ids": [
        "onto-project",
        "spdx23"
      ]
    },
    {
      "id": "assessment-identity",
      "subject": "node:ProductAssessment",
      "rule": "Product IDs are advisory-local. Bind mappings to the exact advisory revision and require reviewed exact-version mapping; preserve unsupported range/product relationships as unresolved.",
      "enforcement": "review",
      "source_ids": [
        "onto-project",
        "csaf20"
      ]
    },
    {
      "id": "historical-selection",
      "subject": "node:AdvisoryRevision",
      "rule": "Apply evaluation and local knowledge cutoffs; compare only declared homogeneous revision scheme; keep different payload digests as distinct immutable records; group by publisher/tracking/revision to flag conflicting same-revision payloads for review.",
      "enforcement": "application",
      "source_ids": [
        "onto-project",
        "csaf20"
      ]
    },
    {
      "id": "status-evidence",
      "subject": "node:ProductAssessment",
      "rule": "Preserve distinct statuses and supporting impact/action evidence. Missing or conflicting evidence remains unresolved; no absence-as-safe.",
      "enforcement": "review",
      "source_ids": [
        "onto-project",
        "csaf20"
      ]
    },
    {
      "id": "no-operational-inference",
      "subject": "model",
      "rule": "SBOM dependency, patch publication and CVSS severity do not prove installed remediation, runtime exploitability or compromise.",
      "enforcement": "review",
      "source_ids": [
        "onto-project",
        "spdx23",
        "cvss40"
      ]
    }
  ],
  "mappings": [
    {
      "id": "spdx-package",
      "source_id": "spdx23",
      "source_term": "SPDX 2.3 sections6.5/7.2 package identity",
      "target": "node:SoftwareComponent",
      "status": "approximated",
      "explanation": "Only package identity/version is projected; file/license/checksum graphs and complete document validation are outside this model.",
      "constraint_ids": [
