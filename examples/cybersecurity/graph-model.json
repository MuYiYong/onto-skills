      ]
    },
    {
      "id": "csaf-assessment",
      "source_id": "csaf20",
      "source_term": "CSAF2.0 product_status and document/tracking",
      "target": "node:ProductAssessment",
      "status": "approximated",
      "explanation": "Retain exact assertion source and statements; full product trees/groups, range matching and all profile tests require additional design. Source terms are not OWL classes.",
