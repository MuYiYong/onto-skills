  "constraints": [
    {
      "id": "chain-order",
      "subject": "node:Transaction",
      "rule": "连续资金链需方向一致、时间先后正确、同币种/口径、状态有效；撤销冲正保留历史，不作为当前有效事件。",
      "enforcement": "application",
      "source_ids": [
        "onto-project"
      ]
    },
    {
      "id": "evidence",
      "subject": "node:InvestigationHypothesis",
      "rule": "共享设备或连通性仅产生候选假设；须保留来源、置信度、反证与复核状态，禁止自动把邻居标为团伙。",
      "enforcement": "review",
      "source_ids": [
        "onto-project"
      ]
    },
    {
      "id": "dedup",
      "subject": "node:EvidenceRecord",
      "rule": "相同 source_system/source_record_id 不重复计独立证据，不同来源的转录也不自动成为独立证据。",
      "enforcement": "application",
      "source_ids": [
        "onto-project"
      ]
    },
    {
      "id": "transfer-endpoints",
      "subject": "node:Transaction",
      "rule": "每个有效简单转账恰好一个 SENT_FROM 和一个 RECEIVED_BY；缺失端点或未拆分批量事件不用于方向链路分析。",
      "enforcement": "application",
      "source_ids": [
        "onto-project"
      ]
    }
  ],
  "mappings": [
    {
      "id": "transaction-source",
      "source_id": "onto-project",
      "source_term": "input.transaction_id",
      "target": "property:Transaction.transaction_id",
      "status": "preserved",
      "explanation": "来源事件身份保留，事件节点承载参与方与状态，非简单时戳属性提升。",
      "constraint_ids": [
        "dedup"
      ]
    }
  ],
  "assumptions": [
