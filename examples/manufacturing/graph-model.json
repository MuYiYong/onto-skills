  "constraints": [
    {
      "id": "lot-identity",
      "subject": "node:MaterialLot",
      "rule": "Never merge lots by product, label, equipment or local lot ID alone; qualify site/issuer and give new output lots to split/merge/rework.",
      "enforcement": "application",
      "source_ids": [
        "onto-project"
      ]
    },
    {
      "id": "event-idempotency",
      "subject": "node:ProcessEvent",
      "rule": "Deduplicate identical issuer+event_id payloads. A conflicting duplicate is rejected, not counted or silently overwritten. Correction requires explicit supersession, absent from this bounded fixture.",
      "enforcement": "application",
      "source_ids": [
        "onto-project"
      ]
    },
    {
      "id": "quantity-basis",
      "subject": "model",
      "rule": "Use decimal arithmetic; reject unit mixing without an explicit conversion factor for a compatible dimension. Missing quantity makes reconciliation incomplete, never zero.",
      "enforcement": "application",
      "source_ids": [
        "onto-project"
      ]
    },
    {
      "id": "mass-balance",
      "subject": "node:ProcessEvent",
      "rule": "When conservation_basis=mass, sum input mass equals output mass plus declared_loss after approved conversions. Scrap is already an output and must not be counted again as declared_loss.",
      "enforcement": "application",
      "source_ids": [
        "onto-project"
      ]
    },
    {
      "id": "genealogy-path",
      "subject": "model",
      "rule": "Traverse only known CONSUMED_BY→PRODUCED material paths. Sharing USES_EQUIPMENT never creates lot ancestry; reject cycles that reuse a lot identity as its own descendant.",
      "enforcement": "application",
      "source_ids": [
        "onto-project"
      ]
    },
    {
      "id": "exposure-sum",
      "subject": "model",
      "rule": "Deduplicate candidate terminal released/shipped lots by qualified identity; do not sum intermediate lots together with descendants. Preserve unknown quantities as unknown totals.",
      "enforcement": "application",
      "source_ids": [
        "onto-project"
      ]
    },
    {
      "id": "inspection-local",
      "subject": "node:QualitySpecification",
      "rule": "Use the supplied local specification version valid at inspection event_time; EPCIS/ISA-95 do not prescribe this example contaminant limit. A downstream pass does not automatically exempt an upstream recall.",
      "enforcement": "review",
      "source_ids": [
        "onto-project"
      ]
    },
    {
      "id": "two-clocks",
      "subject": "node:ProcessEvent",
      "rule": "Keep event_time and observed_at distinct. Include only events at/before event_as_of and observed by knowledge_cutoff; do not fabricate unobserved paths.",
      "enforcement": "application",
      "source_ids": [
        "onto-project"
      ]
    },
    {
      "id": "known-input-allocation",
      "subject": "model",
      "rule": "Across known events, a qualified input lot cannot consume more than known opening quantity plus known production. Missing producer observations leave stock completeness unproven. This bounded fixture fully consumes inputs; partial consumption requires explicit residual lots or allocation records before terminal exposure sums.",
      "enforcement": "application",
      "source_ids": [
        "onto-project"
      ]
    }
  ],
