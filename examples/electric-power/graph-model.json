      "target": "node:Equipment",
      "status": "preserved",
      "explanation": "Preserve the utility-scoped source key; names are display only.",
      "constraint_ids": []
    },
    {
      "id": "source-terminal-connectivity",
      "source_id": "onto-project",
      "source_term": "input.terminals[].terminal_id/connectivity_id/version_id",
      "target": "edge:CONNECTS_TO",
      "status": "preserved",
      "explanation": "Turn each source association into a versioned edge with its source interval and observation clock; do not infer omitted connections.",
      "constraint_ids": []
    },
    {
      "id": "source-state-observation",
      "source_id": "onto-project",
      "source_term": "input.states[]",
      "target": "node:StateObservation",
      "status": "preserved",
      "explanation": "Retain state ID, version, validity, observed_at and evidence; the example state vocabulary is local.",
      "constraint_ids": []
    },
    {
      "id": "source-restoration-segment",
      "source_id": "onto-project",
      "source_term": "input.restoration_segments[]",
      "target": "node:RestorationSegment",
      "status": "preserved",
      "explanation": "Preserve source segment identity and actual service evidence; do not substitute observation time for restoration time.",
      "constraint_ids": []
    }
  ],
  "assumptions": [
    "Synthetic utility U1; UTC half-open intervals; decimal values retain explicit units.",
    "Reachability is a candidate screen: definitely reachable does not prove actual supply.",
    "Immutable observations plus knowledge_cutoff provide a bounded as-known view, not a complete transaction-time database."
  ],
  "unresolved": [],
  "competency_questions": [
    "Which in-scope service points lose all known source paths after an actual asset outage?",
    "Which candidates remain uncertain because of switch, DER or boundary-source evidence?",
    "Which customers are candidates without double counting multiple service points?",
    "What actual interruption durations are supported by restoration segments known at the selected cutoff?"
  ]
}
