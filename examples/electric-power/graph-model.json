  "constraints": [
    {
      "id": "topology-clock",
      "subject": "model",
      "rule": "Use one version valid at event_time and observed by knowledge_cutoff; filter every membership/state on the same two clocks. Incompatible or conflicting active versions reject analysis.",
      "enforcement": "application",
      "source_ids": [
        "onto-project"
      ]
    },
    {
      "id": "state-unknown",
      "subject": "node:StateObservation",
      "rule": "Unknown or missing switch state creates possible adjacency only; unknown source/DER status creates possible supply only. Conflicting observations remain unresolved, never last-write guessed.",
      "enforcement": "application",
      "source_ids": [
        "onto-project"
      ]
    },
    {
      "id": "equipment-path",
      "subject": "node:Equipment",
      "rule": "This aggregate example allows line/switch two-terminal assets and source/DER one-terminal assets. Exclude actual unavailable assets before reachability. Multi-terminal, phases, protection, capacity and islands require a richer study.",
      "enforcement": "application",
      "source_ids": [
        "onto-project"
      ]
    },
    {
      "id": "planned-actual",
      "subject": "node:OutageEvent",
      "rule": "Evaluate planned removal as projected candidates and report actual_outage_count=0; asset outage is distinct from observed customer interruption.",
      "enforcement": "application",
      "source_ids": [
        "onto-project"
      ]
    },
    {
      "id": "restore-union",
      "subject": "node:RestorationSegment",
      "rule": "Use only actual source-supported segments known by cutoff; union overlapping intervals per service point, preserve recurrence, and do not close an unknown end with a guessed timestamp.",
      "enforcement": "application",
      "source_ids": [
        "onto-project"
      ]
    },
    {
      "id": "customer-scope",
      "subject": "edge:CUSTOMER_SERVICE",
      "rule": "Deduplicate customer candidates over valid service bindings; retain service and circuit scope, including boundary supply paths outside the requested customer reporting circuit.",
      "enforcement": "application",
      "source_ids": [
        "onto-project"
      ]
    },
    {
      "id": "no-switching",
      "subject": "model",
      "rule": "Output candidate impacts and uncertainty only; do not emit operational switching instructions or claim safe energization.",
      "enforcement": "review",
      "source_ids": [
        "onto-project"
      ]
    }
  ],
  "mappings": [
    {
      "id": "cim-context",
      "source_id": "iec-cim-base",
      "source_term": "CIM resources, attributes and relationships (public abstract)",
      "target": "node:Equipment",
